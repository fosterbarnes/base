<Window x:Class="Base.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="base"
        Width="520"
        Height="480"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="Manual"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="MainWindow_Loaded"
        Closing="Window_Closing">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TabControl x:Name="PageTabs"
                    Grid.Row="0"
                    SelectionChanged="PageTabs_SelectionChanged"
                    SizeChanged="PageTabs_SizeChanged">
            <TabItem Header="Scripts" Tag="Scripts" />
            <TabItem Header="Settings" Tag="Settings" />
            <TabItem Header="About" Tag="About" />
        </TabControl>
        <Grid Grid.Row="1">
            <Border x:Name="ScriptsPage"
                    Opacity="0"
                    Visibility="Collapsed"
                    Style="{StaticResource ContentPanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ScriptList" HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Width="Auto"
                                        Margin="0,0,0,8"
                                        Padding="16,0"
                                        HorizontalAlignment="Stretch"
                                        FontFamily="Consolas"
                                        FontWeight="SemiBold"
                                        ToolTip="Run in a new terminal"
                                        Click="ScriptButton_Click"
                                        Style="{StaticResource NeutralButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Border x:Name="SettingsPage"
                    VerticalAlignment="Top"
                    Opacity="0"
                    Visibility="Collapsed"
                    Style="{StaticResource ContentPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Terminal" />
                    <ComboBox x:Name="TerminalComboBox"
                              Grid.Column="1"
                              ToolTip="Where script buttons open their script"
                              SelectionChanged="TerminalComboBox_SelectionChanged">
                        <ComboBoxItem Content="Auto (WezTerm if found)" />
                        <ComboBoxItem Content="pwsh window" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border x:Name="AboutPage"
                    Opacity="0"
                    Visibility="Collapsed"
                    Style="{StaticResource ContentPanelStyle}">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Width="128"
                           Height="128"
                           Margin="0,0,16,0"
                           Source="/Resources/icon512.png"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="AboutTitleText"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock x:Name="AboutVersionText"
                                   Margin="0,2,0,10"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Margin="0,0,0,4">
                            <Hyperlink Style="{StaticResource AboutHyperlinkStyle}"
                                       NavigateUri="https://github.com/fosterbarnes/base"
                                       RequestNavigate="AboutHyperlink_RequestNavigate">
                                github.com/fosterbarnes/base
                            </Hyperlink>
                        </TextBlock>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,12,6"
                                       FontWeight="SemiBold"
                                       Text="Install:" />
                            <TextBlock x:Name="AboutInstallPathText"
                                       Grid.Column="1"
                                       Margin="0,0,8,6"
                                       VerticalAlignment="Top"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="2"
                                    Margin="0,0,0,6"
                                    Style="{StaticResource AboutFolderButtonStyle}"
                                    Click="AboutOpenInstallLocation_Click"
                                    ToolTip="Open install location">
                                <materialDesign:PackIcon Kind="FolderArrowRight"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,12,0"
                                       FontWeight="SemiBold"
                                       Text="Settings:" />
                            <TextBlock x:Name="AboutSettingsPathText"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Top"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="0"
                                    Style="{StaticResource AboutFolderButtonStyle}"
                                    Click="AboutOpenSettingsLocation_Click"
                                    ToolTip="Open settings location">
                                <materialDesign:PackIcon Kind="FolderArrowRight"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                        </Grid>
                        <StackPanel Style="{StaticResource AboutCreditLineStackPanelStyle}">
                            <TextBlock Style="{StaticResource AboutCreditLinePartTextBlockStyle}">
                                <Run Text="made with &lt;3 by " Foreground="{StaticResource SecondaryTextBrush}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutCreditLinePartTextBlockStyle}" Margin="0">
                                <Hyperlink Style="{StaticResource AboutHyperlinkStyle}"
                                           NavigateUri="https://github.com/fosterbarnes"
                                           RequestNavigate="AboutHyperlink_RequestNavigate">
                                    fosterbarnes
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
