<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>BaseUpdater</RootNamespace>
    <AssemblyName>baseUpdater</AssemblyName>
    <ApplicationIcon>..\..\.res\icon\icon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared with the main app so both windows use one theme source. -->
    <Page Include="..\base\theme\*.xaml" Link="theme\%(Filename)%(Extension)" />
    <Compile Include="..\base\helpers\WindowsTitleBarTheme.cs" Link="helpers\WindowsTitleBarTheme.cs" />
  </ItemGroup>
</Project>
